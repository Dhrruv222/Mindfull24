PORT=3000
NODE_ENV=development

# Database: Supabase Postgres. In the Supabase dashboard open Project Settings > Database > Connection string
# and copy the "Session pooler" URI (works over IPv4), then insert your database password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development database from docker-compose.yml (npm run db:up):
DATABASE_URL=postgresql://saca:saca_pw@127.0.0.1:5544/saca
# TLS is enabled automatically for non-local hosts. Override with DB_SSL=true|false if needed.

# Auth: use a long random value outside local development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Demo environment: allows the Free/Premium Demo Tier Switcher. Set to false in production.
DEMO_MODE=true

# Randomizer cooldowns (minutes)
RANDOMIZER_COOLDOWN_MINUTES=60
RANDOMIZER_PREMIUM_COOLDOWN_MINUTES=15

# Production (Vercel): use the Supabase Transaction pooler URL (port 6543), a 32+ char JWT_SECRET, and DEMO_MODE=true|false.
# Optional: LOGIN_MAX_FAILURES=10, AUTH_RATE_LIMIT_MAX=30, DB_POOL_MAX=3, DB_SSL_CA=<PEM>
