{
  "name": "advent-calendar-saca",
  "version": "1.0.0",
  "private": true,
  "description": "Advent Calendar (SACA): gamified activity advent calendar platform",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "echo No build step: static frontend plus serverless API",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env backend/migrations/run.js",
    "db:seed": "node --env-file-if-exists=.env database/seeders/seed.js",
    "db:export-sql": "node database/seeders/export-sql.js",
    "backlog:import": "node database/seeders/import-backlog.js",
    "db:reset": "node --env-file-if-exists=.env backend/migrations/run.js --fresh && node --env-file-if-exists=.env database/seeders/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
